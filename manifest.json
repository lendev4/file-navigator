{
  "manifest_version": 3,
  "name": "File Navigator",
  "version": "0.17.0",
  "description": "Browse local files like in a file explorer: folder view with thumbnails, arrow keys to step through files, Markdown, CSV and music.",
  "permissions": ["offscreen", "storage", "tabs"],
  "host_permissions": ["file:///*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open the folder view",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    { "resources": ["viewer.html", "player.html"], "matches": ["file:///*"] }
  ],
  "content_scripts": [
    {
      "matches": ["file:///*"],
      "exclude_matches": ["file:///*/", "file:///"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["file:///*/", "file:///"],
      "js": ["shared.js", "listing.js"],
      "css": ["listing.css"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+E" }
    },
    "next-file": {
      "suggested_key": { "default": "Alt+Shift+Right" },
      "description": "Open the next file in the folder"
    },
    "prev-file": {
      "suggested_key": { "default": "Alt+Shift+Left" },
      "description": "Open the previous file in the folder"
    }
  }
}
